#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	# Wheel is pre-built and mounted at /wheels by the build script

override_dh_auto_test:
	# Tests run separately in CI pre-flight — skip during packaging

override_dh_auto_install:
	pip3 install --no-deps --break-system-packages \
		--root=debian/yabridge-gui-controller --prefix=/usr \
		/wheels/yabridge_gui_controller-*.whl
	# Move any misplaced local/ files to the correct usr/ location
	if [ -d debian/yabridge-gui-controller/usr/local ]; then \
		cp -a debian/yabridge-gui-controller/usr/local/. debian/yabridge-gui-controller/usr/ && \
		rm -rf debian/yabridge-gui-controller/usr/local; \
	fi
	install -Dm644 packaging/specs/yabridge-gui-controller.desktop \
		debian/yabridge-gui-controller/usr/share/applications/yabridge-gui-controller.desktop
	install -Dm644 src/yabridge-gui-controller.png \
		debian/yabridge-gui-controller/usr/share/icons/hicolor/256x256/apps/yabridge-gui-controller.png

override_dh_usrlocal:
