#!/usr/bin/env bash

# Uninstaller for the tar.gz binary tarball installation.
# Usage: ./uninstall [--non-interactive]

set -euo pipefail

NON_INTERACTIVE=0
[[ "${1:-}" == "--non-interactive" ]] && NON_INTERACTIVE=1

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

info() { echo -e "${CYAN}→${NC} $*"; }
ok()   { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }

ask() {
    [[ $NON_INTERACTIVE -eq 1 ]] && return 0
    local ans
    read -r -p "$1 [Y/n] " ans
    [[ -z "$ans" || "$ans" =~ ^[Yy] ]]
}

ask "Uninstall Yabridge GUI Controller?" || { echo "Aborted."; exit 0; }

# ── pip uninstall ─────────────────────────────────────────────────────────────

info "Removing Python package..."
PIP_ARGS=(--yes)
python3 -c "
import sysconfig, pathlib
if (pathlib.Path(sysconfig.get_path('stdlib')) / 'EXTERNALLY-MANAGED').exists():
    raise SystemExit(0)
raise SystemExit(1)
" 2>/dev/null && PIP_ARGS+=(--break-system-packages)

pip3 uninstall "${PIP_ARGS[@]}" yabridge-gui-controller 2>/dev/null && ok "Package removed." || warn "Package not found via pip (may already be removed)."

# ── Desktop integration ───────────────────────────────────────────────────────

DESKTOP="$HOME/.local/share/applications/yabridge-gui-controller.desktop"
ICON="$HOME/.local/share/icons/hicolor/256x256/apps/yabridge-gui-controller.png"

info "Removing desktop entry and icon..."
rm -f "$DESKTOP" "$ICON"
update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
ok "Desktop entry and icon removed."

# ── PATH line in ~/.profile ───────────────────────────────────────────────────

PATH_LINE='export PATH="$HOME/.local/bin:$PATH"'
PROFILE="$HOME/.profile"

if grep -qF "$PATH_LINE" "$PROFILE" 2>/dev/null; then
    info "Removing PATH entry from $PROFILE..."
    grep -vF "$PATH_LINE" "$PROFILE" > "$PROFILE.tmp" && mv "$PROFILE.tmp" "$PROFILE"
    ok "PATH entry removed."
fi

ok "Yabridge GUI Controller uninstalled."
